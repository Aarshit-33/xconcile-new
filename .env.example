# Copy to .env.local and fill in. Same variable names as the old site.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://xconcile.com
# Only "production" on the live deployment; anything else => robots disallow all.
NEXT_PUBLIC_SITE_ENV=development

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Write token (server only): contact submissions, newsletter
SANITY_API_TOKEN=
# Shared secret for the Sanity webhook -> /api/revalidate
SANITY_REVALIDATE_SECRET=

# --- Third parties ---
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_GTM_ID=GTM-WRRFT9ZZ

# --- Email (MS Graph, used by the old /api/contact; port when the lead form is built) ---
ADMIN_EMAIL=
GRAPH_MAILBOX=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Sharing a local server (`npm run share [port]`, dev only) ---
# Free token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional static domain from the ngrok dashboard, e.g. xconcile-dev.ngrok-free.app
NGROK_DOMAIN=
