# Copy to .env.local and fill in. Same variable names as the old site.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://xconcile.com
# Only "production" on the live deployment; anything else => robots disallow all.
NEXT_PUBLIC_SITE_ENV=development

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Every page, blog post and form submission lives in this dataset (not the old site's `production`).
NEXT_PUBLIC_SANITY_DATASET=v2_xconcile
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Write token (server only, Editor role): contact submissions, newsletter.
# Either name works (sanity/env.server.ts): SANITY_API_WRITE_TOKEN is what the Vercel ↔ Sanity
# integration creates; SANITY_API_TOKEN is the old site's name.
SANITY_API_WRITE_TOKEN=
# Read token (server only, Viewer role). Optional while the dataset is public; required if the
# dataset is made private (audit S2). Falls back to the write token.
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity webhook -> /api/revalidate
SANITY_REVALIDATE_SECRET=

# --- Third parties ---
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_GTM_ID=GTM-WRRFT9ZZ

# --- Email (MS Graph): contact form submissions go to connect@xconcile.com ---
# ADMIN_EMAIL overrides the recipient (leave empty for connect@xconcile.com).
ADMIN_EMAIL=
GRAPH_MAILBOX=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional: secret that signs the contact form's math CAPTCHA (falls back to
# SANITY_REVALIDATE_SECRET / the Sanity write token).
CAPTCHA_SECRET=
